#: src/audiocfg.c:28
msgid ""
"Usage: audiocfg [OPTION]...\n"
"Configure PulseAudio devices and card profiles.\n"
msgstr ""
"Verwendung: audiocfg [OPTION]...\n"
"Konfiguriert PulseAudio-Geräte und Kartenprofile.\n"

#: src/audiocfg.c:33
msgid "list playback and capture devices\n"
msgstr "Wiedergabe- und Aufnahmegeräte auflisten\n"

#: src/audiocfg.c:35
msgid "select devices (repeatable); see DEVICE SPEC below\n"
msgstr "Geräte auswählen (wiederholbar); siehe DEVICE SPEC unten\n"

#: src/audiocfg.c:37
msgid "list profiles (all cards, or ones selected with --device)\n"
msgstr "Profile auflisten (alle Karten oder mit --device ausgewählte)\n"

#: src/audiocfg.c:39
msgid "profile index (from --list-profiles) or profile name\n"
msgstr "Profilindex (aus --list-profiles) oder Profilname\n"

#: src/audiocfg.c:41
msgid "cycle profile: comma-separated list, wrap after last (needs --device)\n"
msgstr "Profil wechseln: kommagetrennte Liste, nach dem letzten wieder zum ersten (erfordert --device)\n"

#: src/audiocfg.c:43
msgid "enable selected devices (set a usable card profile)\n"
msgstr "ausgewählte Geräte aktivieren (nutzbares Kartenprofil setzen)\n"

#: src/audiocfg.c:45
msgid "disable selected devices (set card profile to off)\n"
msgstr "ausgewählte Geräte deaktivieren (Kartenprofil auf off setzen)\n"

#: src/audiocfg.c:47
msgid "Device spec (optional playback|capture prefix before : or /):\n"
msgstr "Gerätespezifikation (optionales Präfix playback|capture vor : oder /):\n"

#: src/audiocfg.c:48
msgid "  :NUM       card id\n"
msgstr "  :NUM       Karten-ID\n"

#: src/audiocfg.c:49
msgid "  /PATTERN   description or name contains PATTERN\n"
msgstr "  /PATTERN   Beschreibung oder Name enthält PATTERN\n"

#: src/audiocfg.c:50
msgid "  NAME       PulseAudio name (glob supported)\n"
msgstr "  NAME       PulseAudio-Name (Glob unterstützt)\n"

#: src/audiocfg.c:51
msgid "  N          1-based index from --list\n"
msgstr "  N          1-basierter Index aus --list\n"

#: src/audiocfg.c:54
msgid "repeat for more verbose loggings\n"
msgstr "wiederholen fuer ausfuehrlichere Protokollmeldungen\n"

#: src/audiocfg.c:56
msgid "show less logging messages\n"
msgstr "weniger Protokollmeldungen anzeigen\n"

#: src/audiocfg.c:58
msgid "display this help and exit\n"
msgstr "diese Hilfe anzeigen und beenden\n"

#: src/audiocfg.c:60
msgid "output version information and exit\n"
msgstr "Versionsinformationen anzeigen und beenden\n"

#: src/audiocfg.c:62
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Fehler melden an: <%s>\n"

#: src/audiocfg.c:144
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/audiocfg.c:145
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Lizenz AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/audiocfg.c:147
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Dies ist freie Software: Sie duerfen sie aendern und weitergeben.\n"

#: src/audiocfg.c:149
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Dieses Projekt lehnt KI-Ausbeutung und KI-Hegemonie ab.\n"

#: src/audiocfg.c:150
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Dieses Projekt lehnt gedankenlose MIT-artige Lizenzen und politisch naive BSD-artige Lizenzen ab.\n"

#: src/audiocfg.c:153
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "Es gibt KEINE GARANTIE, soweit gesetzlich zulaessig.\n"

#: src/audiocfg.c:176
msgid "--profile and --toggle are mutually exclusive"
msgstr "--profile und --toggle schließen sich gegenseitig aus"

#: src/audiocfg.c:181
msgid "--enable and --disable are mutually exclusive"
msgstr "--enable und --disable schließen sich gegenseitig aus"

#: src/audiocfg.c:187
msgid "--enable/--disable cannot be combined with --profile/--toggle"
msgstr "--enable/--disable kann nicht mit --profile/--toggle kombiniert werden"

#: src/audiocfg.c:194
msgid "failed to connect to PulseAudio"
msgstr "Verbindung zu PulseAudio fehlgeschlagen"

#: src/profile.c:126
#, c-format
msgid "failed to set profile %s\n"
msgstr "Profil %s konnte nicht gesetzt werden\n"

#: src/profile.c:275 src/profile.c:341 src/profile.c:415
msgid "card not found"
msgstr "Karte nicht gefunden"

#: src/profile.c:284
#, c-format
msgid "no usable profile for card %s\n"
msgstr "kein nutzbares Profil für Karte %s\n"

#: src/profile.c:291 src/profile.c:422
#, c-format
msgid "profile not found: %s\n"
msgstr "Profil nicht gefunden: %s\n"

#: src/profile.c:323
msgid "-d/--device and -t/--toggle are required"
msgstr "-d/--device und -t/--toggle sind erforderlich"

#: src/profile.c:329
msgid "empty or invalid profile list"
msgstr "leere oder ungültige Profilliste"

#: src/profile.c:357
#, c-format
msgid "profile not on card: %s\n"
msgstr "Profil nicht auf Karte: %s\n"

#: src/select.c:131
#, c-format
msgid "invalid device: %s\n"
msgstr "ungültiges Gerät: %s\n"

#: src/select.c:140
#, c-format
msgid "device index out of range: %d\n"
msgstr "Geräteindex außerhalb des Bereichs: %d\n"

#: src/select.c:149
#, c-format
msgid "card not found: %u\n"
msgstr "Karte nicht gefunden: %u\n"

#: src/select.c:198 src/select.c:235
#, c-format
msgid "device not found: %s\n"
msgstr "Gerät nicht gefunden: %s\n"

#: src/select.c:244
msgid "-d/--device is required"
msgstr "-d/--device ist erforderlich"

#: src/select.c:264
msgid "no matching devices"
msgstr "keine passenden Geräte"

#: src/session.c:74
msgid "PulseAudio connection failed"
msgstr "PulseAudio-Verbindung fehlgeschlagen"

#~ msgid "index, :CARD, playback:CARD, capture:CARD, or name (TYPE optional)\n"
#~ msgstr "Index, :CARD, playback:CARD, capture:CARD oder Name (TYPE optional)\n"

