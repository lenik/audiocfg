#: src/audiocfg.c:28
msgid ""
"Usage: audiocfg [OPTION]...\n"
"Configure PulseAudio devices and card profiles.\n"
msgstr ""
"Utilisation : audiocfg [OPTION]...\n"
"Configure les périphériques PulseAudio et les profils de carte.\n"

#: src/audiocfg.c:33
msgid "list playback and capture devices\n"
msgstr "lister les périphériques de lecture et de capture\n"

#: src/audiocfg.c:35
msgid "select devices (repeatable); see DEVICE SPEC below\n"
msgstr "sélectionner des périphériques (répétable) ; voir DEVICE SPEC ci-dessous\n"

#: src/audiocfg.c:37
msgid "list profiles (all cards, or ones selected with --device)\n"
msgstr "lister les profils (toutes les cartes, ou celles sélectionnées avec --device)\n"

#: src/audiocfg.c:39
msgid "profile index (from --list-profiles) or profile name\n"
msgstr "index de profil (depuis --list-profiles) ou nom de profil\n"

#: src/audiocfg.c:41
msgid "cycle profile: comma-separated list, wrap after last (needs --device)\n"
msgstr "faire tourner le profil : liste séparée par des virgules, retour au début après le dernier (requiert --device)\n"

#: src/audiocfg.c:43
msgid "enable selected devices (set a usable card profile)\n"
msgstr "activer les périphériques sélectionnés (définir un profil de carte utilisable)\n"

#: src/audiocfg.c:45
msgid "disable selected devices (set card profile to off)\n"
msgstr "désactiver les périphériques sélectionnés (mettre le profil de carte à off)\n"

#: src/audiocfg.c:47
msgid "Device spec (optional playback|capture prefix before : or /):\n"
msgstr "Spécification de périphérique (préfixe playback|capture optionnel avant : ou /) :\n"

#: src/audiocfg.c:48
msgid "  :NUM       card id\n"
msgstr "  :NUM       id de carte\n"

#: src/audiocfg.c:49
msgid "  /PATTERN   description or name contains PATTERN\n"
msgstr "  /PATTERN   la description ou le nom contient PATTERN\n"

#: src/audiocfg.c:50
msgid "  NAME       PulseAudio name (glob supported)\n"
msgstr "  NAME       nom PulseAudio (glob pris en charge)\n"

#: src/audiocfg.c:51
msgid "  N          1-based index from --list\n"
msgstr "  N          index à base 1 issu de --list\n"

#: src/audiocfg.c:54
msgid "repeat for more verbose loggings\n"
msgstr "repeter pour obtenir des journaux plus verbeux\n"

#: src/audiocfg.c:56
msgid "show less logging messages\n"
msgstr "afficher moins de messages de journal\n"

#: src/audiocfg.c:58
msgid "display this help and exit\n"
msgstr "afficher cette aide et quitter\n"

#: src/audiocfg.c:60
msgid "output version information and exit\n"
msgstr "afficher les informations de version et quitter\n"

#: src/audiocfg.c:62
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Signaler les bugs a : <%s>\n"

#: src/audiocfg.c:144
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/audiocfg.c:145
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Licence AGPL-3.0-or-later : <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/audiocfg.c:147
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Ce logiciel est libre : vous pouvez le modifier et le redistribuer.\n"

#: src/audiocfg.c:149
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Ce projet s'oppose a l'exploitation par l'IA et a l'hegemonie de l'IA.\n"

#: src/audiocfg.c:150
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Ce projet rejette les licences de type MIT sans reflexion et les licences de type BSD politiquement naives.\n"

#: src/audiocfg.c:153
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "AUCUNE GARANTIE n'est fournie, dans les limites permises par la loi.\n"

#: src/audiocfg.c:176
msgid "--profile and --toggle are mutually exclusive"
msgstr "--profile et --toggle sont mutuellement exclusifs"

#: src/audiocfg.c:181
msgid "--enable and --disable are mutually exclusive"
msgstr "--enable et --disable s’excluent mutuellement"

#: src/audiocfg.c:187
msgid "--enable/--disable cannot be combined with --profile/--toggle"
msgstr "--enable/--disable ne peut pas être combiné avec --profile/--toggle"

#: src/audiocfg.c:194
msgid "failed to connect to PulseAudio"
msgstr "échec de connexion à PulseAudio"

#: src/profile.c:126
#, c-format
msgid "failed to set profile %s\n"
msgstr "échec du réglage du profil %s\n"

#: src/profile.c:275 src/profile.c:341 src/profile.c:415
msgid "card not found"
msgstr "carte introuvable"

#: src/profile.c:284
#, c-format
msgid "no usable profile for card %s\n"
msgstr "aucun profil utilisable pour la carte %s\n"

#: src/profile.c:291 src/profile.c:422
#, c-format
msgid "profile not found: %s\n"
msgstr "profil introuvable : %s\n"

#: src/profile.c:323
msgid "-d/--device and -t/--toggle are required"
msgstr "-d/--device et -t/--toggle sont requis"

#: src/profile.c:329
msgid "empty or invalid profile list"
msgstr "liste de profils vide ou invalide"

#: src/profile.c:357
#, c-format
msgid "profile not on card: %s\n"
msgstr "profil absent de la carte : %s\n"

#: src/select.c:131
#, c-format
msgid "invalid device: %s\n"
msgstr "périphérique invalide : %s\n"

#: src/select.c:140
#, c-format
msgid "device index out of range: %d\n"
msgstr "index de périphérique hors limites : %d\n"

#: src/select.c:149
#, c-format
msgid "card not found: %u\n"
msgstr "carte introuvable : %u\n"

#: src/select.c:198 src/select.c:235
#, c-format
msgid "device not found: %s\n"
msgstr "périphérique introuvable : %s\n"

#: src/select.c:244
msgid "-d/--device is required"
msgstr "-d/--device est requis"

#: src/select.c:264
msgid "no matching devices"
msgstr "aucun périphérique correspondant"

#: src/session.c:74
msgid "PulseAudio connection failed"
msgstr "échec de la connexion PulseAudio"

