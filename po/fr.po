#: src/audiocfg.c:28
msgid ""
"Usage: audiocfg [OPTION]...\n"
"Configure PulseAudio devices and card profiles.\n"
msgstr ""
"Utilisation : audiocfg [OPTION]...\n"
"Configure les périphériques PulseAudio et les profils de carte.\n"

#: src/audiocfg.c:33
msgid "list playback and capture devices\n"
msgstr "lister les périphériques de lecture et de capture\n"

#: src/audiocfg.c:35
msgid "index, :CARD, playback:CARD, capture:CARD, or name (TYPE optional)\n"
msgstr "index, :CARD, playback:CARD, capture:CARD ou nom (TYPE optionnel)\n"

#: src/audiocfg.c:37
msgid "list profiles (all cards, or one with --device)\n"
msgstr "lister les profils (toutes les cartes, ou une avec --device)\n"

#: src/audiocfg.c:39
msgid "profile index (from --list-profiles) or profile name\n"
msgstr "index de profil (depuis --list-profiles) ou nom de profil\n"

#: src/audiocfg.c:41
msgid "cycle profile: comma-separated list, wrap after last (needs --device)\n"
msgstr ""
"faire tourner le profil : liste séparée par des virgules, retour au début "
"après le dernier (requiert --device)\n"

#: src/audiocfg.c:44
msgid "repeat for more verbose loggings\n"
msgstr "repeter pour obtenir des journaux plus verbeux\n"

#: src/audiocfg.c:46
msgid "show less logging messages\n"
msgstr "afficher moins de messages de journal\n"

#: src/audiocfg.c:48
msgid "display this help and exit\n"
msgstr "afficher cette aide et quitter\n"

#: src/audiocfg.c:50
msgid "output version information and exit\n"
msgstr "afficher les informations de version et quitter\n"

#: src/audiocfg.c:52
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Signaler les bugs a : <%s>\n"

#: src/audiocfg.c:110
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/audiocfg.c:111
msgid ""
"License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr ""
"Licence AGPL-3.0-or-later : <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/audiocfg.c:113
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Ce logiciel est libre : vous pouvez le modifier et le redistribuer.\n"

#: src/audiocfg.c:115
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr ""
"Ce projet s'oppose a l'exploitation par l'IA et a l'hegemonie de l'IA.\n"

#: src/audiocfg.c:116
msgid ""
"This project rejects mindless MIT-style licensing and politically naive BSD-"
"style licensing.\n"
msgstr ""
"Ce projet rejette les licences de type MIT sans reflexion et les licences de"
" type BSD politiquement naives.\n"

#: src/audiocfg.c:119
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "AUCUNE GARANTIE n'est fournie, dans les limites permises par la loi.\n"

#: src/audiocfg.c:138
msgid "--profile and --toggle are mutually exclusive"
msgstr "--profile et --toggle sont mutuellement exclusifs"

#: src/audiocfg.c:144
msgid "failed to connect to PulseAudio"
msgstr "échec de connexion à PulseAudio"

#: src/lib.c:102
msgid "PulseAudio connection failed"
msgstr "échec de la connexion PulseAudio"

#: src/lib.c:378
#, c-format
msgid "invalid device: %s\n"
msgstr "périphérique invalide : %s\n"

#: src/lib.c:389
#, c-format
msgid "device index out of range: %d\n"
msgstr "index de périphérique hors limites : %d\n"

#: src/lib.c:405
#, c-format
msgid "card not found: %u\n"
msgstr "carte introuvable : %u\n"

#: src/lib.c:418
#, c-format
msgid "%s device not found for card %u\n"
msgstr "périphérique %s introuvable pour la carte %u\n"

#: src/lib.c:442
#, c-format
msgid "device not found: %s\n"
msgstr "périphérique introuvable : %s\n"

#: src/lib.c:518
#, c-format
msgid "failed to set profile %s\n"
msgstr "échec du réglage du profil %s\n"

#: src/lib.c:604
msgid "-d/--device and -t/--toggle are required"
msgstr "-d/--device et -t/--toggle sont requis"

#: src/lib.c:610
msgid "empty or invalid profile list"
msgstr "liste de profils vide ou invalide"

#: src/lib.c:625 src/lib.c:681
msgid "card not found"
msgstr "carte introuvable"

#: src/lib.c:634
#, c-format
msgid "profile not on card: %s\n"
msgstr "profil absent de la carte : %s\n"

#: src/lib.c:688
#, c-format
msgid "profile not found: %s\n"
msgstr "profil introuvable : %s\n"
