#: src/audiocfg.c:28
msgid ""
"Usage: audiocfg [OPTION]...\n"
"Configure PulseAudio devices and card profiles.\n"
msgstr ""
"用法：audiocfg [選項]...\n"
"設定 PulseAudio 裝置與音效卡設定檔。\n"

#: src/audiocfg.c:33
msgid "list playback and capture devices\n"
msgstr "列出播放與擷取裝置\n"

#: src/audiocfg.c:35
msgid "index, :CARD, playback:CARD, capture:CARD, or name (TYPE optional)\n"
msgstr "索引、:CARD、playback:CARD、capture:CARD 或名稱（類型可選）\n"

#: src/audiocfg.c:37
msgid "list profiles (all cards, or one with --device)\n"
msgstr "列出設定檔（全部音效卡，或配合 --device 指定一張）\n"

#: src/audiocfg.c:39
msgid "profile index (from --list-profiles) or profile name\n"
msgstr "設定檔索引（來自 --list-profiles）或設定檔名稱\n"

#: src/audiocfg.c:41
msgid "cycle profile: comma-separated list, wrap after last (needs --device)\n"
msgstr "循環切換設定檔：逗號分隔清單，最後一項後回到第一項（需要 --device）\n"

#: src/audiocfg.c:44
msgid "repeat for more verbose loggings\n"
msgstr "重複使用以顯示更多詳細日誌\n"

#: src/audiocfg.c:46
msgid "show less logging messages\n"
msgstr "顯示較少的日誌訊息\n"

#: src/audiocfg.c:48
msgid "display this help and exit\n"
msgstr "顯示此說明並結束\n"

#: src/audiocfg.c:50
msgid "output version information and exit\n"
msgstr "輸出版本資訊並結束\n"

#: src/audiocfg.c:52
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "回報問題到：<%s>\n"

#: src/audiocfg.c:110
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "版權所有 (C) %d %s\n"

#: src/audiocfg.c:111
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "授權 AGPL-3.0-or-later：<https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/audiocfg.c:113
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "這是自由軟體：你可以自由修改並再散布。\n"

#: src/audiocfg.c:115
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "本專案反對 AI 剝削與 AI 霸權。\n"

#: src/audiocfg.c:116
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "本專案反對無腦 MIT 式授權與政治愚蠢 BSD 式授權。\n"

#: src/audiocfg.c:119
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "在法律允許範圍內，不提供任何保證。\n"

#: src/audiocfg.c:138
msgid "--profile and --toggle are mutually exclusive"
msgstr "--profile 與 --toggle 不能同時使用"

#: src/audiocfg.c:144
msgid "failed to connect to PulseAudio"
msgstr "連線 PulseAudio 失敗"

#: src/lib.c:102
msgid "PulseAudio connection failed"
msgstr "PulseAudio 連線失敗"

#: src/lib.c:378
#, c-format
msgid "invalid device: %s\n"
msgstr "無效裝置：%s\n"

#: src/lib.c:389
#, c-format
msgid "device index out of range: %d\n"
msgstr "裝置索引超出範圍：%d\n"

#: src/lib.c:405
#, c-format
msgid "card not found: %u\n"
msgstr "找不到音效卡：%u\n"

#: src/lib.c:418
#, c-format
msgid "%s device not found for card %u\n"
msgstr "音效卡 %2$u 找不到 %1$s 裝置\n"

#: src/lib.c:442
#, c-format
msgid "device not found: %s\n"
msgstr "找不到裝置：%s\n"

#: src/lib.c:518
#, c-format
msgid "failed to set profile %s\n"
msgstr "設定設定檔 %s 失敗\n"

#: src/lib.c:604
msgid "-d/--device and -t/--toggle are required"
msgstr "需要 -d/--device 與 -t/--toggle"

#: src/lib.c:610
msgid "empty or invalid profile list"
msgstr "設定檔清單為空或無效"

#: src/lib.c:625 src/lib.c:681
msgid "card not found"
msgstr "找不到音效卡"

#: src/lib.c:634
#, c-format
msgid "profile not on card: %s\n"
msgstr "音效卡上不存在設定檔：%s\n"

#: src/lib.c:688
#, c-format
msgid "profile not found: %s\n"
msgstr "找不到設定檔：%s\n"
