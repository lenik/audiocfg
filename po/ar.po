#: src/audiocfg.c:28
msgid ""
"Usage: audiocfg [OPTION]...\n"
"Configure PulseAudio devices and card profiles.\n"
msgstr ""
"الاستخدام: audiocfg [خيار]...\n"
"تهيئة أجهزة PulseAudio وملفات البطاقة.\n"

#: src/audiocfg.c:33
msgid "list playback and capture devices\n"
msgstr "سرد أجهزة التشغيل والتسجيل\n"

#: src/audiocfg.c:35
msgid "select devices (repeatable); see DEVICE SPEC below\n"
msgstr "تحديد الأجهزة (قابل للتكرار)؛ انظر DEVICE SPEC أدناه\n"

#: src/audiocfg.c:37
msgid "list profiles (all cards, or ones selected with --device)\n"
msgstr "سرد الملفات الشخصية (كل البطاقات، أو المحددة بـ --device)\n"

#: src/audiocfg.c:39
msgid "profile index (from --list-profiles) or profile name\n"
msgstr "فهرس الملف الشخصي (من --list-profiles) أو اسم الملف الشخصي\n"

#: src/audiocfg.c:41
msgid "cycle profile: comma-separated list, wrap after last (needs --device)\n"
msgstr "تبديل الملف الشخصي: قائمة مفصولة بفواصل، يعود للأول بعد الأخير (يتطلب --device)\n"

#: src/audiocfg.c:43
msgid "enable selected devices (set a usable card profile)\n"
msgstr "تمكين الأجهزة المحددة (تعيين ملف بطاقة صالح)\n"

#: src/audiocfg.c:45
msgid "disable selected devices (set card profile to off)\n"
msgstr "تعطيل الأجهزة المحددة (تعيين ملف البطاقة إلى off)\n"

#: src/audiocfg.c:47
msgid "Device spec (optional playback|capture prefix before : or /):\n"
msgstr "مواصفة الجهاز (بادئة playback|capture اختيارية قبل : أو /):\n"

#: src/audiocfg.c:48
msgid "  :NUM       card id\n"
msgstr "  :NUM       معرّف البطاقة\n"

#: src/audiocfg.c:49
msgid "  /PATTERN   description or name contains PATTERN\n"
msgstr "  /PATTERN   الوصف أو الاسم يحتوي على PATTERN\n"

#: src/audiocfg.c:50
msgid "  NAME       PulseAudio name (glob supported)\n"
msgstr "  NAME       اسم PulseAudio (يدعم glob)\n"

#: src/audiocfg.c:51
msgid "  N          1-based index from --list\n"
msgstr "  N          فهرس يبدأ من 1 من --list\n"

#: src/audiocfg.c:54
msgid "repeat for more verbose loggings\n"
msgstr "كرر لمزيد من رسائل السجل التفصيلية\n"

#: src/audiocfg.c:56
msgid "show less logging messages\n"
msgstr "عرض رسائل سجل أقل\n"

#: src/audiocfg.c:58
msgid "display this help and exit\n"
msgstr "عرض هذه المساعدة والخروج\n"

#: src/audiocfg.c:60
msgid "output version information and exit\n"
msgstr "إخراج معلومات الإصدار والخروج\n"

#: src/audiocfg.c:62
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "أبلغ عن الأخطاء إلى: <%s>\n"

#: src/audiocfg.c:144
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "حقوق النشر (C) %d %s\n"

#: src/audiocfg.c:145
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "الترخيص AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/audiocfg.c:147
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "هذا برنامج حر: يمكنك تغييره وإعادة توزيعه.\n"

#: src/audiocfg.c:149
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "يعارض هذا المشروع استغلال الذكاء الاصطناعي وهيمنته.\n"

#: src/audiocfg.c:150
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "يرفض هذا المشروع تراخيص MIT غير المدروسة وتراخيص BSD الساذجة سياسياً.\n"

#: src/audiocfg.c:153
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "لا توجد أي ضمانات، في الحدود التي يسمح بها القانون.\n"

#: src/audiocfg.c:176
msgid "--profile and --toggle are mutually exclusive"
msgstr "--profile و --toggle متنافيان"

#: src/audiocfg.c:181
msgid "--enable and --disable are mutually exclusive"
msgstr "--enable و --disable متنافيان"

#: src/audiocfg.c:187
msgid "--enable/--disable cannot be combined with --profile/--toggle"
msgstr "لا يمكن الجمع بين --enable/--disable و --profile/--toggle"

#: src/audiocfg.c:194
msgid "failed to connect to PulseAudio"
msgstr "فشل الاتصال بـ PulseAudio"

#: src/profile.c:126
#, c-format
msgid "failed to set profile %s\n"
msgstr "فشل تعيين الملف الشخصي %s\n"

#: src/profile.c:275 src/profile.c:341 src/profile.c:415
msgid "card not found"
msgstr "البطاقة غير موجودة"

#: src/profile.c:284
#, c-format
msgid "no usable profile for card %s\n"
msgstr "لا يوجد ملف شخصي صالح للبطاقة %s\n"

#: src/profile.c:291 src/profile.c:422
#, c-format
msgid "profile not found: %s\n"
msgstr "الملف الشخصي غير موجود: %s\n"

#: src/profile.c:323
msgid "-d/--device and -t/--toggle are required"
msgstr "يلزم -d/--device و -t/--toggle"

#: src/profile.c:329
msgid "empty or invalid profile list"
msgstr "قائمة الملفات الشخصية فارغة أو غير صالحة"

#: src/profile.c:357
#, c-format
msgid "profile not on card: %s\n"
msgstr "الملف الشخصي غير موجود على البطاقة: %s\n"

#: src/select.c:131
#, c-format
msgid "invalid device: %s\n"
msgstr "جهاز غير صالح: %s\n"

#: src/select.c:140
#, c-format
msgid "device index out of range: %d\n"
msgstr "فهرس الجهاز خارج النطاق: %d\n"

#: src/select.c:149
#, c-format
msgid "card not found: %u\n"
msgstr "البطاقة غير موجودة: %u\n"

#: src/select.c:198 src/select.c:235
#, c-format
msgid "device not found: %s\n"
msgstr "الجهاز غير موجود: %s\n"

#: src/select.c:244
msgid "-d/--device is required"
msgstr "-d/--device مطلوب"

#: src/select.c:264
msgid "no matching devices"
msgstr "لا توجد أجهزة مطابقة"

#: src/session.c:74
msgid "PulseAudio connection failed"
msgstr "فشل اتصال PulseAudio"
