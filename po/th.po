#: src/audiocfg.c:28
msgid ""
"Usage: audiocfg [OPTION]...\n"
"Configure PulseAudio devices and card profiles.\n"
msgstr ""
"การใช้งาน: audiocfg [OPTION]...\n"
"กำหนดค่าอุปกรณ์ PulseAudio และโปรไฟล์การ์ด\n"

#: src/audiocfg.c:33
msgid "list playback and capture devices\n"
msgstr "แสดงรายการอุปกรณ์เล่นและบันทึก\n"

#: src/audiocfg.c:35
msgid "index, :CARD, playback:CARD, capture:CARD, or name (TYPE optional)\n"
msgstr "ดัชนี, :CARD, playback:CARD, capture:CARD หรือชื่อ (TYPE ไม่บังคับ)\n"

#: src/audiocfg.c:37
msgid "list profiles (all cards, or one with --device)\n"
msgstr "แสดงโปรไฟล์ (ทุกการ์ด หรือหนึ่งการ์ดด้วย --device)\n"

#: src/audiocfg.c:39
msgid "profile index (from --list-profiles) or profile name\n"
msgstr "ดัชนีโปรไฟล์ (จาก --list-profiles) หรือชื่อโปรไฟล์\n"

#: src/audiocfg.c:41
msgid "cycle profile: comma-separated list, wrap after last (needs --device)\n"
msgstr ""
"สลับโปรไฟล์: รายการคั่นด้วยจุลภาค วนกลับหลังรายการสุดท้าย (ต้องมี "
"--device)\n"

#: src/audiocfg.c:44
msgid "repeat for more verbose loggings\n"
msgstr "ใส่ซ้ำเพื่อแสดงบันทึกแบบละเอียดมากขึ้น\n"

#: src/audiocfg.c:46
msgid "show less logging messages\n"
msgstr "แสดงข้อความบันทึกให้น้อยลง\n"

#: src/audiocfg.c:48
msgid "display this help and exit\n"
msgstr "แสดงความช่วยเหลือนี้และออก\n"

#: src/audiocfg.c:50
msgid "output version information and exit\n"
msgstr "แสดงข้อมูลเวอร์ชันและออก\n"

#: src/audiocfg.c:52
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "รายงานบั๊กไปที่: <%s>\n"

#: src/audiocfg.c:110
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "ลิขสิทธิ์ (C) %d %s\n"

#: src/audiocfg.c:111
msgid ""
"License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr ""
"สัญญาอนุญาต AGPL-3.0-or-later: "
"<https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/audiocfg.c:113
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "นี่คือซอฟต์แวร์เสรี คุณมีสิทธิ์แก้ไขและแจกจ่ายต่อได้\n"

#: src/audiocfg.c:115
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "โครงการนี้คัดค้านการเอาเปรียบด้วย AI และอำนาจนำของ AI\n"

#: src/audiocfg.c:116
msgid ""
"This project rejects mindless MIT-style licensing and politically naive BSD-"
"style licensing.\n"
msgstr ""
"โครงการนี้ปฏิเสธใบอนุญาตแบบ MIT ที่ไร้วิจารณญาณ และใบอนุญาตแบบ BSD "
"ที่โง่เขลาทางการเมือง\n"

#: src/audiocfg.c:119
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "ไม่มีการรับประกันใด ๆ ตามขอบเขตที่กฎหมายอนุญาต\n"

#: src/audiocfg.c:138
msgid "--profile and --toggle are mutually exclusive"
msgstr "--profile และ --toggle ใช้พร้อมกันไม่ได้"

#: src/audiocfg.c:144
msgid "failed to connect to PulseAudio"
msgstr "เชื่อมต่อ PulseAudio ไม่สำเร็จ"

#: src/lib.c:102
msgid "PulseAudio connection failed"
msgstr "การเชื่อมต่อ PulseAudio ล้มเหลว"

#: src/lib.c:378
#, c-format
msgid "invalid device: %s\n"
msgstr "อุปกรณ์ไม่ถูกต้อง: %s\n"

#: src/lib.c:389
#, c-format
msgid "device index out of range: %d\n"
msgstr "ดัชนีอุปกรณ์เกินช่วง: %d\n"

#: src/lib.c:405
#, c-format
msgid "card not found: %u\n"
msgstr "ไม่พบการ์ด: %u\n"

#: src/lib.c:418
#, c-format
msgid "%s device not found for card %u\n"
msgstr "ไม่พบอุปกรณ์ %s สำหรับการ์ด %u\n"

#: src/lib.c:442
#, c-format
msgid "device not found: %s\n"
msgstr "ไม่พบอุปกรณ์: %s\n"

#: src/lib.c:518
#, c-format
msgid "failed to set profile %s\n"
msgstr "ตั้งโปรไฟล์ %s ไม่สำเร็จ\n"

#: src/lib.c:604
msgid "-d/--device and -t/--toggle are required"
msgstr "ต้องระบุ -d/--device และ -t/--toggle"

#: src/lib.c:610
msgid "empty or invalid profile list"
msgstr "รายการโปรไฟล์ว่างหรือไม่ถูกต้อง"

#: src/lib.c:625 src/lib.c:681
msgid "card not found"
msgstr "ไม่พบการ์ด"

#: src/lib.c:634
#, c-format
msgid "profile not on card: %s\n"
msgstr "ไม่มีโปรไฟล์บนการ์ด: %s\n"

#: src/lib.c:688
#, c-format
msgid "profile not found: %s\n"
msgstr "ไม่พบโปรไฟล์: %s\n"
