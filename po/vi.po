#: src/audiocfg.c:28
msgid ""
"Usage: audiocfg [OPTION]...\n"
"Configure PulseAudio devices and card profiles.\n"
msgstr ""
"Cách dùng: audiocfg [OPTION]...\n"
"Cấu hình thiết bị PulseAudio và profile thẻ âm.\n"

#: src/audiocfg.c:33
msgid "list playback and capture devices\n"
msgstr "liệt kê thiết bị phát và thu âm\n"

#: src/audiocfg.c:35
msgid "index, :CARD, playback:CARD, capture:CARD, or name (TYPE optional)\n"
msgstr "chỉ mục, :CARD, playback:CARD, capture:CARD hoặc tên (TYPE tùy chọn)\n"

#: src/audiocfg.c:37
msgid "list profiles (all cards, or one with --device)\n"
msgstr "liệt kê profile (tất cả thẻ, hoặc một thẻ với --device)\n"

#: src/audiocfg.c:39
msgid "profile index (from --list-profiles) or profile name\n"
msgstr "chỉ mục profile (từ --list-profiles) hoặc tên profile\n"

#: src/audiocfg.c:41
msgid "cycle profile: comma-separated list, wrap after last (needs --device)\n"
msgstr "chuyển vòng profile: danh sách phân tách bằng dấu phẩy, quay lại đầu sau mục cuối (cần --device)\n"

#: src/audiocfg.c:44
msgid "repeat for more verbose loggings\n"
msgstr "lap lai de hien thi nhieu nhat ky chi tiet hon\n"

#: src/audiocfg.c:46
msgid "show less logging messages\n"
msgstr "hien thi it thong diep nhat ky hon\n"

#: src/audiocfg.c:48
msgid "display this help and exit\n"
msgstr "hiển thị trợ giúp này và thoát\n"

#: src/audiocfg.c:50
msgid "output version information and exit\n"
msgstr "in thông tin phiên bản và thoát\n"

#: src/audiocfg.c:52
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Báo lỗi tới: <%s>\n"

#: src/audiocfg.c:110
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Bản quyền (C) %d %s\n"

#: src/audiocfg.c:111
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Giấy phép AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/audiocfg.c:113
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Đây là phần mềm tự do: bạn có thể sửa đổi và phân phối lại.\n"

#: src/audiocfg.c:115
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Dự án này phản đối bóc lột AI và bá quyền AI.\n"

#: src/audiocfg.c:116
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Dự án này bác bỏ kiểu cấp phép MIT máy móc và kiểu cấp phép BSD ngây ngô về chính trị.\n"

#: src/audiocfg.c:119
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "KHÔNG CÓ BẤT KỲ BẢO HÀNH nào trong phạm vi luật cho phép.\n"

#: src/audiocfg.c:138
msgid "--profile and --toggle are mutually exclusive"
msgstr "--profile và --toggle không được dùng cùng lúc"

#: src/audiocfg.c:144
msgid "failed to connect to PulseAudio"
msgstr "kết nối PulseAudio thất bại"

#: src/lib.c:102
msgid "PulseAudio connection failed"
msgstr "kết nối PulseAudio thất bại"

#: src/lib.c:378
#, c-format
msgid "invalid device: %s\n"
msgstr "thiết bị không hợp lệ: %s\n"

#: src/lib.c:389
#, c-format
msgid "device index out of range: %d\n"
msgstr "chỉ mục thiết bị vượt phạm vi: %d\n"

#: src/lib.c:405
#, c-format
msgid "card not found: %u\n"
msgstr "không tìm thấy thẻ: %u\n"

#: src/lib.c:418
#, c-format
msgid "%s device not found for card %u\n"
msgstr "không tìm thấy thiết bị %s cho thẻ %u\n"

#: src/lib.c:442
#, c-format
msgid "device not found: %s\n"
msgstr "không tìm thấy thiết bị: %s\n"

#: src/lib.c:518
#, c-format
msgid "failed to set profile %s\n"
msgstr "đặt profile %s thất bại\n"

#: src/lib.c:604
msgid "-d/--device and -t/--toggle are required"
msgstr "cần -d/--device và -t/--toggle"

#: src/lib.c:610
msgid "empty or invalid profile list"
msgstr "danh sách profile rỗng hoặc không hợp lệ"

#: src/lib.c:625 src/lib.c:681
msgid "card not found"
msgstr "không tìm thấy thẻ"

#: src/lib.c:634
#, c-format
msgid "profile not on card: %s\n"
msgstr "profile không có trên thẻ: %s\n"

#: src/lib.c:688
#, c-format
msgid "profile not found: %s\n"
msgstr "không tìm thấy profile: %s\n"
